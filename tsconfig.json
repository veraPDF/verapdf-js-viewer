{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "dist",
        "module": "esnext",
        "target": "es2019",
        "lib": ["dom", "es2019"],
        "sourceMap": true,
        "allowJs": false,
        "jsx": "react",
        "declaration": true,
        "moduleResolution": "bundler",
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "react-pdf/dist/shared/types": ["./node_modules/react-pdf/dist/shared/types.d.ts"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "example", "rollup.config.js"]
}
